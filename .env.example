# ---------------------------------------------------------------------------
# Hermes Voice — environment configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- xAI (optional if ElevenLabs is configured) ----------------------------
# API key with Realtime Voice access. Stays server-side; the browser only ever
# receives short-lived ephemeral tokens minted from it.
XAI_API_KEY=

# Realtime voice model. `grok-voice-latest` tracks the current recommended
# version. Note this is the *voice* model — Hermes keeps using Grok 4.5 for
# reasoning.
XAI_VOICE_MODEL=grok-voice-latest

# Built-in voice id used for spoken output.
XAI_VOICE=eve

# Lifetime of the ephemeral browser token, in seconds. xAI caps this at 3600.
XAI_TOKEN_TTL_SECONDS=600

# --- ElevenLabs (optional if xAI is configured) ----------------------------
# Custom / generated / cloned voice ids are the point of this provider.
# At least one of XAI_API_KEY or (ELEVENLABS_API_KEY + ELEVENLABS_VOICE_ID)
# must be set. When both are set, the picker lets you switch. Setting
# ELEVENLABS_API_KEY without ELEVENLABS_VOICE_ID is a startup error even if
# xAI is configured — a half-configured provider fails loudly rather than
# disappearing from the picker.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Pre-created Conversational AI agent. If omitted, the server
# creates a Hermes front-end agent (ask_hermes client tool) on first use.
# A pre-created agent must have the `tts.voice_id` and `agent.prompt.prompt`
# overrides enabled in its security settings, otherwise ElevenLabs ignores the
# per-session voice and every session speaks with the agent's own voice.
ELEVENLABS_AGENT_ID=
# Optional curated picker list: Name:voiceId,Name:voiceId
# If empty, the authenticated picker loads the account catalogue.
# ELEVENLABS_VOICE_ID is always offered, listed here or not.
ELEVENLABS_VOICES=

# Default provider when both are configured: xai | elevenlabs
VOICE_PROVIDER=xai

# --- Hermes agent (required) -----------------------------------------------
# Base URL of the Hermes `api_server` gateway platform. Default when Hermes
# runs on the same host. This platform must be enabled in your gateway config.
HERMES_API_URL=http://127.0.0.1:8642

# Bearer key the Hermes api_server platform authenticates with — the same
# value your gateway already uses (API_SERVER_KEY on the Hermes side).
API_SERVER_KEY=

# Optional. Scopes Hermes long-term memory for voice conversations. Leave
# empty to use Hermes defaults.
HERMES_SESSION_KEY=

# Timeout for a single Hermes turn, in milliseconds. Voice callers will not
# wait long, but agent turns that use tools can be slow.
HERMES_TIMEOUT_MS=120000

# --- App authentication (required) -----------------------------------------
# Passphrase for the web app. Choose something long; it is the only thing
# between the network and your agent.
APP_PASSWORD=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a login lasts before re-authentication is required.
SESSION_TTL_HOURS=168

# --- Server ----------------------------------------------------------------
PORT=8787

# Bind address. Keep 127.0.0.1 when fronted by a reverse proxy or
# `tailscale serve`. Use 0.0.0.0 only if you know what is listening.
HOST=127.0.0.1

# Set to `false` only for local http:// development. In any real deployment
# leave this true so cookies carry the Secure flag.
COOKIE_SECURE=true

# debug | info | warn | error
LOG_LEVEL=info

# --- Voice persona (optional) ----------------------------------------------
# Instructions for the voice front-end model. Hermes remains the source of
# truth for actual personality and knowledge; this only shapes speech and
# turn-taking. Leave empty to use the built-in default.
VOICE_INSTRUCTIONS=
